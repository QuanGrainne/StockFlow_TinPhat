# Chép thành .env.e2e.local (đã ignore) và điền giá trị thật. KHÔNG commit file .local.
#
# Kết nối tới PostgreSQL CỤC BỘ (kiểu chuỗi Npgsql). KHÔNG ghi Database: tên database do bộ test
# quyết định và chỉ được là stockflow_e2e_test / stockflow_e2e_template. Ghi Database khác (vd stockflow_dev)
# hoặc Host không phải localhost thì bộ test dừng ngay, không kết nối.
STOCKFLOW_E2E_PG=Host=localhost;Port=5432;Username=<user>;Password=<mật khẩu>;SearchPath=stockflow,public

# Mật khẩu mặc định của các tài khoản seed (admin, manager01, sales01, whstaff01, prodstaff01)
# và của nhân viên tạo mới khi để trống mật khẩu (xem DatabaseSeeder / CreateStaffCommand).
E2E_DEFAULT_PASSWORD=<mật khẩu mặc định>

# Không bắt buộc (mặc định như dưới)
# E2E_WEB_URL=http://localhost:3000      # phải là cổng 3000 vì CORS của API chỉ cho localhost:3000
# E2E_API_URL=http://localhost:5100
# E2E_REBUILD_TEMPLATE=1                 # dựng lại database mẫu
# E2E_REBUILD_FRONTEND=1                 # build lại frontend
# E2E_SKIP_RESET=1                       # KHÔNG dựng lại stockflow_e2e_test (chỉ dùng để thử cô lập dữ liệu)
