{
  "name": "stockflow-e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "System / E2E test cho StockFlow theo Report 5.3 (Playwright, chạy trên frontend + API + PostgreSQL thật, database riêng stockflow_e2e_test)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "e2e:pilot": "playwright test --grep @pilot --project=chrome-1366",
    "e2e:pilot:1920": "playwright test --grep @pilot --project=chrome-1920",
    "e2e:test": "playwright test",
    "e2e:report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
