# Cửa vào duy nhất của stack Docker (trình duyệt → :8080 → Caddy):
#   /api/*   → api:8080 (ASP.NET Core)
#   còn lại  → web:3000 (Next.js)
# Web và API cùng một địa chỉ nên trình duyệt không cần CORS.
{
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		# Ảnh hàng hoá đang lưu base64 trong request JSON → cho phép body lớn
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
