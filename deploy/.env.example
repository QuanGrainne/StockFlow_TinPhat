# StockFlow — biến môi trường cho Docker Compose (deploy/compose.yml).
#   cp deploy/.env.example deploy/.env      (deploy/.env đã nằm trong .gitignore, KHÔNG commit)
#
# Mọi giá trị dưới đây là giá trị DEV. Trước khi cho máy khác truy cập (demo LAN, server):
# đổi POSTGRES_PASSWORD và JWT_SECRET_KEY.

# --- PostgreSQL (chỉ đọc khi volume pgdata được tạo lần đầu) ---
POSTGRES_DB=stockflow_dev
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow-dev-pass
# Cổng trên máy để xem DB bằng pgAdmin/psql (khác 5432 của Postgres cài sẵn)
DB_PORT=5433

# --- API ---
# Khoá ký JWT, ít nhất 32 ký tự. Đổi khoá → mọi phiên đăng nhập cũ hết hiệu lực.
JWT_SECRET_KEY=stockflow-docker-dev-secret-key-change-me-0123456789
# true = mỗi lần API khởi động tạo lại nhân viên mẫu (manager01, sales01...) và kho mẫu K001–K004 nếu thiếu.
# false = bản deploy: chỉ đảm bảo tài khoản admin, giữ nguyên nhân viên / kho do Admin quản lý.
SEED_DEMO_DATA=true

# --- Web ---
# Cổng mở trang web: http://localhost:8080
HTTP_PORT=8080
# 127.0.0.1 = chỉ máy này; 0.0.0.0 = máy khác cùng mạng LAN truy cập được (demo trên điện thoại)
HTTP_BIND=127.0.0.1
# Cổng HTTPS trên máy (VPS có tên miền: 443)
HTTPS_PORT=8443
# Tên miền của site. Bỏ trống = chỉ HTTP trên HTTP_PORT (chạy local).
# VPS: SITE_ADDRESS=stockflow.tenmien.vn, HTTP_PORT=80, HTTPS_PORT=443, HTTP_BIND=0.0.0.0
SITE_ADDRESS=

# --- payOS (QR thanh toán chuyển khoản ở màn Bán hàng) ---
# Lấy tại my.payos.vn → Kênh thanh toán → Thông tin tích hợp. KHÔNG commit khóa thật.
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# Trang payOS chuyển về sau khi thanh toán / hủy trên trang checkout (đổi khi deploy có tên miền)
PAYOS_RETURN_URL=http://localhost:8080/pos
PAYOS_CANCEL_URL=http://localhost:8080/pos
# Ngân hàng / số tài khoản cố định hiển thị ở mục "chuyển khoản thủ công" trên QR (trống = dùng tài khoản payOS)
PAYOS_BANK_NAME=ACB
PAYOS_BANK_ACCOUNT_NUMBER=82004268
