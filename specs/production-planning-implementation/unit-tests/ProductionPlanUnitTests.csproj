<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kiểm thử đơn vị cho luật thuần của Kế hoạch sản xuất (Domain + Application helpers).
    Chỉ dùng ProjectReference, KHÔNG thêm NuGet package; không nằm trong StockFlow.sln.
    Chạy: dotnet run (tham số project) specs/production-planning-implementation/unit-tests
    Khi nhóm duyệt thêm xUnit (xunit, xunit.runner.visualstudio, Microsoft.NET.Test.Sdk) thì chuyển các ca này sang project test.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\StockFlow_Backend\StockFlow.Domain\StockFlow.Domain.csproj" />
    <ProjectReference Include="..\..\..\StockFlow_Backend\StockFlow.Application\StockFlow.Application.csproj" />
  </ItemGroup>

</Project>
